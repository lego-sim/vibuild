  "anchors": {
    "100": "No discernible difference within the observed scope",
    "90": "Only tiny differences",
    "80": "Broadly consistent with minor defects",
    "70": "Obvious local defects",
    "50": "Major elements clearly wrong",
    "25": "Only fragments match",
    "0": "Absent or wholly contradictory"
